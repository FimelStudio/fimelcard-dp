# 所有牌统一使用纸；Fast Card只设置牌面，飞行参数由cardtable公共动画模块写入
# 花色模型前缀：d=方块、c=黑桃、h=红心、s=梅花
tag @e[type=minecraft:item,tag=fc.new_dealt_card] remove fc.new_dealt_card
function cardtable:animation/deal/spawn_card
tag @e[type=minecraft:item,tag=ct.new_dealt_card,distance=..2,sort=nearest,limit=1] add fc.new_dealt_card

execute if score @s fc_card matches 1 run item replace entity @e[type=minecraft:item,tag=fc.new_dealt_card,limit=1] contents with minecraft:paper[minecraft:item_model="card:poker/c_10",minecraft:item_name="黑桃10",minecraft:custom_data={fast_card:{card:1b,id:1,rank:10,suit:"spade"}},minecraft:max_stack_size=1]
execute if score @s fc_card matches 2 run item replace entity @e[type=minecraft:item,tag=fc.new_dealt_card,limit=1] contents with minecraft:paper[minecraft:item_model="card:poker/h_10",minecraft:item_name="红心10",minecraft:custom_data={fast_card:{card:1b,id:2,rank:10,suit:"heart"}},minecraft:max_stack_size=1]
