$dialog show @a[tag=ct.settings_actor,limit=1] {type:"minecraft:confirmation",title:{text:"命悬一线 · 游戏设置",color:"gold"},body:[{type:"minecraft:plain_message",width:440,contents:{text:"每轮随机一题，不自动打开对话框。书本模式：第一页填写后Q提交；对话框模式：按Q使用紫色染料，自行打开手牌并修改描述。对话框提交需要OP权限，普通玩家请选择书本。"}}],inputs:[{type:"minecraft:single_option",key:"input",label:{text:"答案输入方式"},width:320,options:[{id:"1",display:{text:"书本（默认）"},initial:$(book)},{id:"2",display:{text:"对话框（提交需要OP）"},initial:$(form)}]}],yes:{label:{text:"保存"},action:{type:"minecraft:dynamic/run_command",template:"trigger it_settings set $(nonce)$(input)"}},no:{label:{text:"取消"},action:{type:"minecraft:run_command",command:"trigger it_settings set 0"}},pause:false}
