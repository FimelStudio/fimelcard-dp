dialog show @a[tag=ct.rules_actor,limit=1] {"type":"minecraft:notice","title":{"text":"骷髅牌 · 游戏规则","color":"gold","bold":true},"body":[{"type":"minecraft:plain_message","width":480,"contents":[{"text":"人数与目标\n","color":"aqua","bold":true},{"text":"2至6人。每人3张花牌和1张骷髅牌（糖骷髅）。累计挑战成功两次，或成为唯一还有牌的玩家，即获胜。","color":"white"}]},{"type":"minecraft:plain_message","width":480,"contents":[{"text":"操作方式\n","color":"aqua","bold":true},{"text":"界面操作：","color":"white","bold":true},{"text":"扣牌用Q；叫号、翻牌、弃牌用对话框，紫色染料按Q重开。桌心显示各玩家扣牌数量，牌堆放在各玩家前方，未翻开时显示牌背，翻开后显示花或骷髅。","color":"white"}]},{"type":"minecraft:plain_message","width":480,"contents":[{"text":"对局流程\n","color":"aqua","bold":true},{"text":"第一步：扣牌：","color":"white","bold":true},{"text":"每人先选一张手牌按Q秘密扣下。随后从起始玩家顺时针行动：再扣一张，或开始叫号。\n首次每人限一张；之后只有轮到自己、尚未叫号时才可加牌。无效出牌会返还。","color":"white"},{"text":"\n\n"},{"text":"第二步：叫号竞标：","color":"white","bold":true},{"text":"用紫色染料按Q打开对话框，选择愿意翻开的数量。叫号不能小于自己扣牌数，也不能超过桌面总牌数。\n开始叫号后，全桌不能加牌，只能提高叫号或放弃竞标；放弃者的牌仍参与挑战。叫到桌面总数时直接成为挑战者。","color":"white"},{"text":"\n\n"},{"text":"第三步：翻牌挑战：","color":"white","bold":true},{"text":"挑战者先从上往下自动翻自己的全部牌，再通过对话框选择其他人的牌堆，每次翻堆顶一张。\n翻够叫号数量且全是花牌：成功一次。翻到任意骷髅：立即失败。","color":"white"}]},{"type":"minecraft:plain_message","width":480,"contents":[{"text":"特殊规则\n","color":"aqua","bold":true},{"text":"失败代价与下一轮：","color":"white","bold":true},{"text":"翻到别人的骷髅：从挑战者全部剩余牌中等概率随机永久弃一张。\n翻到自己的骷髅：自己秘密选一张永久弃掉，包含本轮已扣牌。弃牌内容仅本人可见，无牌者淘汰。\n剩余牌收回，永久弃牌不补。挑战者先开始下一轮；若已淘汰，则顺时针下一人开始。","color":"white"}]},{"type":"minecraft:plain_message","width":480,"contents":[{"text":"暂停与结束\n","color":"aqua","bold":true},{"text":"任一参与者离线，整桌暂停；全部原参与者重新上线后继续。等待期间可通过桌边“结束游戏”投票中止；已结束后才上线的玩家会清除旧局道具与状态。下椅不等于退出。重载保留当前对局，旧窗口通过当前操作物重开。规则窗口本身不会暂停游戏。","color":"white"}]},{"type":"minecraft:plain_message","width":480,"contents":[{"text":"管理命令\n","color":"aqua","bold":true},{"text":"有命令权限的管理员可在同维度牌桌8格内执行 /function skull:admin/abort，中止最近一场本游戏并保留牌桌。普通玩家通过桌边菜单和游戏操作物游玩。","color":"white"}]}],"action":{"label":{"text":"关闭规则"},"width":140},"pause":false,"can_close_with_escape":true}
