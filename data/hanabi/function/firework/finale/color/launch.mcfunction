# 先升空，再以物理扩散分枝；每条分枝末端生成同色原版烟花。

$function fimel_sklibs:skfirework/fx/launch {config:{life:$(life),cmdv:[{cmd:"playsound minecraft:entity.firework_rocket.large_blast master @a[distance=..48] ~ ~ ~ 1.0 1.0"},{cmd:"function fimel_sklibs:skfirework/fx/spread",args:{config:{pitch:[-180,180],yaw:[-72,-28],t:[$(t0),$(t1)],n:$(branches),v:$(v),g:$(g),tick_cmdv:[{cmd:"particle minecraft:end_rod ~ ~ ~ 0 0 0 0 1 force"}],cmdv:[{cmd:"function fimel_sklibs:skfirework/fx/firework",args:{config:{shape:$(color_shape),colors:{from:[I;$(primary),$(accent)],to:[I;$(fade)]},n:1,trail:$(trail),twinkle:$(color_twinkle)}}}]}}}]}}
