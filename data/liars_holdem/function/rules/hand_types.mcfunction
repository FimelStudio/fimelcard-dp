dialog show @s {type:"minecraft:notice",title:{text:"德州扑克牌型大小",color:"gold"},body:[{type:"minecraft:plain_message",contents:[{text:"由大到小\n",color:"yellow",bold:true},{text:"1. 皇家同花顺：同花色10、J、Q、K、A。\n2. 同花顺：同花色的五张连续牌。\n3. 四条：四张同点数牌。\n4. 葫芦：三条加一对。\n5. 同花：五张同花色牌。\n6. 顺子：五张连续点数牌。\n7. 三条：三张同点数牌。\n8. 两对：两个对子。\n9. 一对：两张同点数牌。\n10. 高牌：以上均不成立。",color:"white"}],width:430},{type:"minecraft:plain_message",contents:[{text:"同牌型比较\n",color:"aqua",bold:true},{text:"同花顺和顺子比较最高张；四条比较四条点数，再比踢脚；葫芦先比三条再比对子；同花与高牌从最大牌逐张比较；三条先比三条再依次比两张踢脚；两对先比大对、再比小对、最后比踢脚；一对先比对子，再依次比三张踢脚。",color:"white"}],width:430},{type:"minecraft:plain_message",contents:[{text:"A与平局\n",color:"light_purple",bold:true},{text:"A固定作为14，是最大单牌，不能作为1使用；因此A、2、3、4、5不构成顺子或同花顺。花色永远不参与胜负。所有比较键完全相同即为平局，并列玩家都不接受本局左轮判定。",color:"white"}],width:430}],pause:false}
