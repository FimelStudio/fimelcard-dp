# 规则窗口不暂停牌局；底部按钮通过trigger打开详细牌型说明
scoreboard players set @a[tag=ct.rules_actor,limit=1] lh_help 0
scoreboard players enable @a[tag=ct.rules_actor,limit=1] lh_help
dialog show @a[tag=ct.rules_actor,limit=1] {type:"minecraft:notice",title:{text:"赌命德州扑克规则",color:"red"},body:[{type:"minecraft:plain_message",contents:[{text:"牌组与目标\n",color:"gold",bold:true},{text:"使用不含大小王的52张牌，支持2至8人开局。每人两张手牌，桌面五张公共牌；从七张牌中组成最强五张。左轮击发者淘汰，最后一名存活玩家赢得整场。",color:"white"}],width:440},{type:"minecraft:plain_message",contents:[{text:"行动方式\n",color:"aqua",bold:true},{text:"轮到你时，快捷栏会出现Call和Fold物品，选中后按Q执行。普通阶段Q丢Call会增加1发；把Call拿在主手按F可提前ALL IN。最终抉择阶段按F全押，全押响应阶段用Q丢Call跟随。",color:"white"}],width:440},{type:"minecraft:plain_message",contents:[{text:"换牌\n",color:"light_purple",bold:true},{text:"每局一次，在前三个普通行动阶段轮到你时，Q丢一张手牌会打开三选一换牌窗口。三张候选、被换掉的牌都离开本局牌库；退出窗口默认选择第一张。ALL IN后全桌禁止换牌。",color:"white"}],width:440},{type:"minecraft:plain_message",contents:[{text:"弃牌与左轮\n",color:"yellow",bold:true},{text:"弃牌会立刻按当前子弹数扣动一次8槽左轮：1至7发的死亡率为子弹数÷8；8发时95%击发、5%卡弹。空枪后等待下一局，击发则淘汰。摊牌会依次亮出最佳五张牌并排名，失败者再按座位顺序用8发依次判定。",color:"white"}],width:440},{type:"minecraft:plain_message",contents:[{text:"公共牌阶段\n",color:"green",bold:true},{text:"第一次行动后翻开前三张，第二次后翻第四张，第三次后翻第五张；随后只能ALL IN或FOLD。任意玩家提前ALL IN后，其余人只能跟随或弃牌，响应完成会自动翻完公共牌并摊牌。",color:"white"}],width:440}],pause:false,can_close_with_escape:true,action:{label:{text:"查看牌型大小",color:"gold"},action:{type:"minecraft:run_command",command:"trigger lh_help set 1"}}}
