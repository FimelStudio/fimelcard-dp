# Action Bar 仅向本队发送，不会让对方看到秘密关键字。
scoreboard players operation #ctx dc_ctx = @s dc_id
function decrypto:hud/load_keywords
execute as @a[tag=dc.player,scores={dc_team=1}] if score @s dc_id = #ctx dc_ctx run title @s actionbar [{text:'白队词库：',color:'white',bold:true},{nbt:'white',storage:'decrypto:hud',color:'aqua'}]
execute if score @s dc_mode matches 4 as @a[tag=dc.player,scores={dc_team=2}] if score @s dc_id = #ctx dc_ctx run title @s actionbar [{text:'黑队词库：',color:'dark_gray',bold:true},{nbt:'black',storage:'decrypto:hud',color:'light_purple'}]
# 加密阶段持续向当前加密者显示本轮密码，避免一次性的聊天提示被刷走。
execute if score @s dc_state matches 2 as @a[tag=dc.player,scores={dc_team=1,dc_encoder=1}] if score @s dc_id = #ctx dc_ctx run title @s actionbar [{text:'白队词库：',color:'white',bold:true},{nbt:'white',storage:'decrypto:hud',color:'aqua'},{text:'　｜　本轮密码：',color:'gold',bold:true},{score:{name:'@e[type=minecraft:marker,tag=dc.controller,sort=nearest,limit=1]',objective:'dc_w1'},color:'yellow'},{text:' - ',color:'gray'},{score:{name:'@e[type=minecraft:marker,tag=dc.controller,sort=nearest,limit=1]',objective:'dc_w2'},color:'yellow'},{text:' - ',color:'gray'},{score:{name:'@e[type=minecraft:marker,tag=dc.controller,sort=nearest,limit=1]',objective:'dc_w3'},color:'yellow'}]
execute if score @s dc_state matches 4 as @a[tag=dc.player,scores={dc_team=2,dc_encoder=1}] if score @s dc_id = #ctx dc_ctx run title @s actionbar [{text:'黑队词库：',color:'dark_gray',bold:true},{nbt:'black',storage:'decrypto:hud',color:'light_purple'},{text:'　｜　本轮密码：',color:'gold',bold:true},{score:{name:'@e[type=minecraft:marker,tag=dc.controller,sort=nearest,limit=1]',objective:'dc_b1'},color:'yellow'},{text:' - ',color:'gray'},{score:{name:'@e[type=minecraft:marker,tag=dc.controller,sort=nearest,limit=1]',objective:'dc_b2'},color:'yellow'},{text:' - ',color:'gray'},{score:{name:'@e[type=minecraft:marker,tag=dc.controller,sort=nearest,limit=1]',objective:'dc_b3'},color:'yellow'}]
