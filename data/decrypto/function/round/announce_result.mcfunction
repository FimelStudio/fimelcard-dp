# 仅在解密者提交后调用；必须早于清空答案、生成新密码和胜负清理。
scoreboard players operation #ctx dc_ctx = @s dc_id
tag @a[tag=dc.round_audience] remove dc.round_audience
execute as @a[tag=dc.player] if score @s dc_id = #ctx dc_ctx run tag @s add dc.round_audience
execute if score @s dc_mode matches 3 if score #phase dc_ctx matches 6 run tellraw @a[tag=dc.round_audience] [{"text":"[第 ","color":"aqua"},{"score":{"name":"@s","objective":"dc_round"},"color":"yellow"},{"text":" 回合·合作队结算]","color":"aqua"}]
execute if score @s dc_mode matches 4 if score #phase dc_ctx matches 6 run tellraw @a[tag=dc.round_audience] [{"text":"[第 ","color":"aqua"},{"score":{"name":"@s","objective":"dc_round"},"color":"yellow"},{"text":" 回合·白队结算]","color":"aqua"}]
execute if score @s dc_mode matches 4 if score #phase dc_ctx matches 8 run tellraw @a[tag=dc.round_audience] [{"text":"[第 ","color":"aqua"},{"score":{"name":"@s","objective":"dc_round"},"color":"yellow"},{"text":" 回合·黑队结算]","color":"aqua"}]
execute if score #phase dc_ctx matches 6 run tellraw @a[tag=dc.round_audience] [{"text":"正确密码：","color":"gold"},{"score":{"name":"@s","objective":"dc_w1"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_w2"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_w3"},"color":"yellow"}]
execute if score #phase dc_ctx matches 8 run tellraw @a[tag=dc.round_audience] [{"text":"正确密码：","color":"gold"},{"score":{"name":"@s","objective":"dc_b1"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_b2"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_b3"},"color":"yellow"}]
tellraw @a[tag=dc.round_audience] [{"text":"解密者输入密码：","color":"aqua"},{"score":{"name":"@s","objective":"dc_guess1"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_guess2"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_guess3"},"color":"yellow"}]
execute if score @s dc_round matches 1 run tellraw @a[tag=dc.round_audience] [{"text":"拦截者输入密码：","color":"light_purple"},{"text":"本回合不拦截","color":"gray"}]
execute unless score @s dc_round matches 1 if score #phase dc_ctx matches 6 run tellraw @a[tag=dc.round_audience] [{"text":"拦截者输入密码：","color":"light_purple"},{"score":{"name":"@s","objective":"dc_bg1"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_bg2"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_bg3"},"color":"yellow"}]
execute unless score @s dc_round matches 1 if score #phase dc_ctx matches 8 run tellraw @a[tag=dc.round_audience] [{"text":"拦截者输入密码：","color":"light_purple"},{"score":{"name":"@s","objective":"dc_wg1"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_wg2"},"color":"yellow"},{"text":"-","color":"white"},{"score":{"name":"@s","objective":"dc_wg3"},"color":"yellow"}]
tag @a[tag=dc.round_audience] remove dc.round_audience
