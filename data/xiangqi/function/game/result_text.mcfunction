execute if score @s xq_result matches 1 if score @s xq_bot matches 1 run function cardtable:game/result/title {audience:"@a[tag=xq.audience]",title:{text:"红方获胜",color:"red",bold:true},subtitle:{text:"人机",color:"aqua"}}
