# 身份卡默认放第8格；已有物品时给予背包，不覆盖其他物品。
execute if items entity @s inventory.* *[minecraft:custom_data~{avalon:{role_card:1b}}] run return 0
execute if items entity @s hotbar.* *[minecraft:custom_data~{avalon:{role_card:1b}}] run return 0
execute if items entity @s weapon.offhand *[minecraft:custom_data~{avalon:{role_card:1b}}] run return 0
execute if score @s av_role matches 1 unless items entity @s hotbar.7 * run return run item replace entity @s hotbar.7 with minecraft:paper[minecraft:custom_data={avalon:{role_card:1b}},minecraft:item_model="card:avalon/merlin",minecraft:item_name={text:"梅林 · 好人",color:"aqua",italic:false},minecraft:lore=[{text:"你的阿瓦隆身份；按Q可在聊天栏查看私人身份信息和操作。",color:"gray",italic:false}]] 1
