data modify storage magical_athlete:rules characters set value [{"id":0,"slug":"alchemist","name":"炼金术士","ability":"主要移动掷出1或2，可改走4格。"},{"id":1,"slug":"baba-yaga","name":"芭芭雅嘎","ability":"与别的运动员先后停在同一格时，绊倒对方。"},{"id":2,"slug":"banana","name":"香蕉","ability":"超越你的运动员完成移动后绊倒。"},{"id":3,"slug":"blimp","name":"飞艇","ability":"回合开始在第15格前，主要移动加3；否则减1。"},{"id":4,"slug":"centaur","name":"半人马","ability":"每超越一位运动员，让其后退2格，不退过起点。"},{"id":5,"slug":"cheerleader","name":"啦啦队长","ability":"主要移动前，可让所有末位前进2格，再自己前进1格。"},{"id":6,"slug":"coach","name":"教练","ability":"与你同格的运动员主要移动加1，也包括你。"},{"id":7,"slug":"copycat","name":"模仿猫","ability":"持续复制在场领先者的技能；并列时选一位，不复制赛前技能。"},{"id":8,"slug":"dicemonger","name":"骰子商人","ability":"所有运动员每回合可额外重掷一次主要移动骰；别人使用时你先走1格。"},{"id":9,"slug":"duelist","name":"决斗家","ability":"与其他运动员同格时可决斗，掷骰较高者前进2格，平局你赢。"},{"id":10,"slug":"egg","name":"蛋蛋","ability":"赛前抽取3位未使用的角色，从中选一位获得技能，包含赛前技能。"},{"id":11,"slug":"flip-flop","name":"人字拖","ability":"可用与一位运动员同时交换位置，代替掷骰与主要移动。"},{"id":12,"slug":"genius","name":"天才","ability":"主要移动掷骰前可猜点数，猜中则完整结算后再行动一次。"},{"id":13,"slug":"gunk","name":"黏液怪","ability":"其他运动员的主要移动减1格，骰子点数不变。"},{"id":14,"slug":"hare","name":"野兔","ability":"主要移动加2；回合开始若独自领先，跳过主要移动。"},{"id":15,"slug":"heckler","name":"起哄者","ability":"一位运动员结束回合时，若位置比回合起点变化不超过1格，你前进2格。"},{"id":16,"slug":"huge-baby","name":"巨婴","ability":"起点以外不能与别人同格，其他运动员会被放到你后面一格，此放置不是移动。"},{"id":17,"slug":"hypnotist","name":"催眠师","ability":"主要移动前，可把另一位运动员传送到你所在格。"},{"id":18,"slug":"inchworm","name":"尺蠖","ability":"别人主要移动掷出1时，取消他的主要移动，你前进1格。"},{"id":19,"slug":"lackey","name":"跟班","ability":"别人主要移动掷出6时，在他移动前，你前进2格。"},{"id":20,"slug":"leaptoad","name":"跳跳蟾蜍","ability":"移动经过有别的运动员的格子时跳过这些格子，不消耗步数；后退也适用。"},{"id":21,"slug":"legs","name":"大长腿","ability":"可不掷骰，直接以5格作为主要移动的基础距离。"},{"id":22,"slug":"lovable-loser","name":"可爱的倒霉蛋","ability":"主要移动前，若独自在最后一名，获得1分。"},{"id":23,"slug":"magician","name":"魔术师","ability":"每次主要移动，最多重掷两次，最后一次骰子结果必须使用。"},{"id":24,"slug":"mastermind","name":"幕后军师","ability":"首个回合开始时预测本场冠军；猜中则立即结束比赛，你取得亚军，可预测自己。"},{"id":25,"slug":"mouth","name":"大嘴怪","ability":"你停到恰有一位其他运动员的格子时，淘汰对方；只剩一位时直接分配剩余名次。"},{"id":26,"slug":"party-animal","name":"派对动物","ability":"主要移动前，其他运动员同时向你移动1格；每位同格者使你主要移动加1。"},{"id":27,"slug":"rocket-scientist","name":"火箭科学家","ability":"掷出主要移动骰后，可把基础距离翻倍，但完成移动后绊倒。"},{"id":28,"slug":"romantic","name":"浪漫家","ability":"一位运动员停到恰有另一位的格子时，你前进2格；两位同时到达不触发。"},{"id":29,"slug":"scoocher","name":"蹭蹭怪","ability":"其他运动员的一次技能实际生效时，你前进1格。"},{"id":30,"slug":"sisyphus","name":"西西弗斯","ability":"赛前得4分；主要移动掷出6时，改为传送回起点并失去1分，分数不低于0。"},{"id":31,"slug":"skipper","name":"船长","ability":"任何运动员主要移动掷出1时，下一个回合由你开始，之后从你左邻继续。"},{"id":32,"slug":"stickler","name":"较真怪","ability":"其他运动员必须恰好到达第30格；任何一次移动若会超过终点，该次移动不执行。"},{"id":33,"slug":"suckerfish","name":"吸盘鱼","ability":"与你同格的一位运动员移动时，可与其一起到达目的地；不是传送，也能一起冲线。"},{"id":34,"slug":"third-wheel","name":"电灯泡","ability":"主要移动前，可传送到恰好站着两位运动员的格子，然后照常主要移动。"},{"id":35,"slug":"twin","name":"双胞胎","ability":"赛前可复制一位此前拿到冠军的运动员的技能，也执行其赛前技能。"}]
